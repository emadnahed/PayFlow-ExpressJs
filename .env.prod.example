# =============================================================================
# PayFlow — Production Environment Variables
# =============================================================================
# Setup:
#   1. cp .env.prod.example .env.prod
#   2. Fill in ALL "REQUIRED" values below
#   3. NEVER commit .env.prod to version control
#
# The app calls validateProductionEnv() at startup and will refuse to start
# if any required variable is empty or missing.
# =============================================================================

# =============================================================================
# REQUIRED — App will not start without these
# =============================================================================

# JWT secret — MUST be 32+ characters
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# Redis password — required by validateProductionEnv()
# Also add to redis command if you enable --requirepass on the Redis container
REDIS_PASSWORD=CHANGE_ME_generate_a_strong_password

# Allowed CORS origins (comma-separated, no trailing slash)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# AUTHENTICATION (optional — sensible defaults in compose)
# =============================================================================

# JWT_ACCESS_TOKEN_EXPIRES_IN=15m
# JWT_REFRESH_TOKEN_EXPIRES_IN=7d
# BCRYPT_ROUNDS=12

# =============================================================================
# RATE LIMITING (optional — strict defaults for production)
# =============================================================================

# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# AUTH_RATE_LIMIT_MAX=5
# TX_RATE_LIMIT_MAX=10
# API_RATE_LIMIT_MAX=30
# WEBHOOK_RATE_LIMIT_MAX=10

# =============================================================================
# WEBHOOKS (optional — defaults in environments.ts)
# =============================================================================

# WEBHOOK_TIMEOUT_MS=10000
# WEBHOOK_RETRY_ATTEMPTS=5
# WEBHOOK_MAX_FAILURE_COUNT=10

# =============================================================================
# LOAD TESTING (optional)
# =============================================================================
# Set this to enable bypass of rate limits via X-Load-Test-Token header
# LOAD_TEST_SECRET=change_me_to_a_random_string

# =============================================================================
# LOGGING & OBSERVABILITY (optional)
# =============================================================================

# LOG_LEVEL=info
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=payflow-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
