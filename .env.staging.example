# =============================================================================
# PayFlow — Staging Environment Variables
# =============================================================================
# Setup:
#   1. cp .env.staging.example .env.staging
#   2. Fill in ALL "REQUIRED" values below
#   3. NEVER commit .env.staging to version control
#
# Staging runs with NODE_ENV=production so validateProductionEnv() fires.
# Same required vars as production — but values can be less strict.
# =============================================================================

# =============================================================================
# REQUIRED — App will not start without these
# =============================================================================

# JWT secret — can be simpler than production, but still 32+ characters
JWT_SECRET=staging_secret_CHANGE_ME_at_least_32_chars

# Redis password — required by validateProductionEnv()
REDIS_PASSWORD=staging_redis_password

# CORS_ORIGINS defaults to * in the staging compose file.
# Uncomment to restrict:
# CORS_ORIGINS=https://staging.yourdomain.com

# =============================================================================
# AUTHENTICATION (optional — relaxed defaults in staging compose)
# =============================================================================

# JWT_ACCESS_TOKEN_EXPIRES_IN=1h
# JWT_REFRESH_TOKEN_EXPIRES_IN=7d
# BCRYPT_ROUNDS=10

# =============================================================================
# RATE LIMITING (optional — relaxed for testing)
# =============================================================================

# Set to true to disable all rate limiting during load tests
# RATE_LIMIT_DISABLED=true
# RATE_LIMIT_MAX_REQUESTS=1000
# AUTH_RATE_LIMIT_MAX=50
# TX_RATE_LIMIT_MAX=100

# =============================================================================
# LOAD TESTING (optional)
# =============================================================================
# LOAD_TEST_SECRET=staging_load_test_secret

# =============================================================================
# LOGGING & OBSERVABILITY (optional — debug level by default in staging)
# =============================================================================

# LOG_LEVEL=debug
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=payflow-staging-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
